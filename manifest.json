{
  "manifest_version": 3,
  "name": "Science Tokyo OTP Autofill",
  "version": "0.7.0",
  "description": "Automatically enter your Science Tokyo username, password, and OTP after a one-time setup.",
  "minimum_chrome_version": "105",
  "action": {
    "default_title": "Science Tokyo OTP settings"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://isct.ex-tic.com/auth/session/second_factor*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://isct.ex-tic.com/auth/session",
        "https://isct.ex-tic.com/auth/session?*"
      ],
      "js": [
        "login_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
